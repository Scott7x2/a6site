{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/api/:path*",           "destination": "https://a6site-site.vercel.app/api/:path*" },
    { "source": "/steam-login",          "destination": "https://a6site-site.vercel.app/steam-login" },
    { "source": "/steam-login/:path*",   "destination": "https://a6site-site.vercel.app/steam-login/:path*" },
    { "source": "/vincular",             "destination": "https://a6site-site.vercel.app/vincular" },
    { "source": "/vincular/:path*",      "destination": "https://a6site-site.vercel.app/vincular/:path*" },
    { "source": "/logout",               "destination": "https://a6site-site.vercel.app/logout" }
  ],
  "headers": [
    { "source": "/(img|fonts|video)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=2592000, immutable" }] },
    { "source": "/api/(.*)",          "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] },
    { "source": "/steam-login(.*)",   "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] },
    { "source": "/vincular(.*)",      "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] },
    { "source": "/logout",            "headers": [{ "key": "x-vercel-enable-rewrite-caching", "value": "0" }] }
  ]
}
